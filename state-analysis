## DESERTS BY STATE
library(tidyverse)
childcare_data<-read_csv("cap_ccaccess_2025_revised_02282026.csv") ##this includes the revised local access measures that Won generated in February 2026
desert_threshold <- 0.33 ##this sets the threshold for what qualifies as a desert; since the existing definition refers to areas with 3 kids under 6 for every 1 licensed slot, the cap is 0.33

desert_by_state <- childcare_data %>%
  mutate(in_desert = adj_supply < desert_threshold) %>%
  group_by(state_name) %>%
  summarise(
    total_children = n(),
    children_in_desert = sum(in_desert, na.rm = TRUE),
    percent_in_desert = (children_in_desert / total_children) * 100,
    mean_adj_supply = mean(adj_supply, na.rm = TRUE)
    ) %>%
  arrange(desc(percent_in_desert))
view(desert_by_state)

  ##this gives you the estimated children in a desert & percent in desert & mean adjusted supply

## DESERTS / LOW SUPPLY BY STATE
desert_comparison<-childcare_data%>%
  group_by(state_name)%>%
  summarise(
    total_children=n(),
    pct_zero_supply=(sum(adj_supply==0,na.rm=TRUE)/n())*100,
    pct_low_supply=(sum(adj_supply<0.1,na.rm=TRUE)/n())*100,
    pct_desert=(sum(adj_supply<0.33,na.rm=TRUE)/n())*100,
    mean_supply=mean(adj_supply,na.rm=TRUE)
    )%>%
  arrange(desc(pct_desert))
view(desert_comparison)

  ## this gives you a breakdown of total children by state, mean suppy value, and the percent of children with values adj_supply = 0 (no licensed care); adj_supply<0.1 (at least 10 kids for every 1 licensed slot) and <0.33 (between 3 and 10 kids for every 1 licensed slot
                                                                                                                                                                                                                              
